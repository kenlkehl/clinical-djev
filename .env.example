# The managed `serve` command runs one vLLM process on this GPU.
DJEV_GPU=1
DJEV_ENGINE_PYTHON=.venv-gpu/bin/python
DJEV_RUNTIME_CACHE=.runtime-cache
DJEV_HF_HOME=/home/klkehl/.cache/huggingface
DJEV_UPSTREAM=http://127.0.0.1:8010
DJEV_HOST=127.0.0.1
DJEV_PORT=8011
DJEV_MAX_MODEL_LEN=32768
DJEV_MAX_NUM_BATCHED_TOKENS=16384
DJEV_CANVAS_LENGTH=64
DJEV_MAX_CONCURRENT_READS=4
DJEV_MAX_ACTIVE_REQUESTS=16
DJEV_GPU_MEMORY_UTILIZATION=0.85
DJEV_STARTUP_TIMEOUT=1800
# Set when exposing the API beyond localhost.
# DJEV_API_KEY=...
# DJEV_UPSTREAM_API_KEY=...
